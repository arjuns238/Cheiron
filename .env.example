# ── LLM provider ──────────────────────────────────────────────────────────────
# Which provider backs the four LLM touchpoints (router, planner, judge, chart selector).
# One of: anthropic | openai
LLM_PROVIDER=anthropic

# Anthropic — required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_LARGE=claude-opus-5
ANTHROPIC_MODEL_SMALL=claude-haiku-4-5

# OpenAI — required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_LARGE=gpt-5.4
OPENAI_MODEL_SMALL=gpt-5.4-mini

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Pages fetched per leg, at 1,000 records each. Unset means 10 pages / 10,000
# records — a default chosen to hold on a small container, since retained records
# cost ~2.3 KB each and peak memory scales with the slice (~23 MB here, ~227 MB at
# 100 pages). Raise it where there is headroom: a higher cap answers more questions
# whole rather than as a sample. Must be a positive integer — an unparseable value
# is a startup error rather than a silent revert to the default.
# CHEIRON_MAX_PAGES=10
